# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - MI CACHÉ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BREVO TRANSACTIONAL EMAIL
# ------------------------------------------------------------------------------
# API Key generada desde tu cuenta de Brevo (antiguo Sendinblue)
BREVO_API_KEY=tu_api_key_de_brevo_aqui

# Habilitar o deshabilitar el envío real de correos (true/false)
# Si está en false, se simulará el envío por los logs
BREVO_ENABLED=false

# Datos del remitente verificado en tu cuenta de Brevo
BREVO_SENDER_NAME=Caché
BREVO_SENDER_EMAIL=info@micache.es

# IDs de las plantillas creadas en el panel de Brevo
BREVO_TPL_OTP=1
BREVO_TPL_FEEDBACK=2
BREVO_TPL_PASSWORD=3
BREVO_TPL_REMINDER=4

# ------------------------------------------------------------------------------
# 2. ENLACES Y FRONTEND
# ------------------------------------------------------------------------------
# URL del cliente web para enlaces interactivos en las plantillas de correo
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. BASE DE DATOS (POSTGRESQL LOCAL)
# ------------------------------------------------------------------------------
# Utilizado por Spring Boot para conectar a la base de datos local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/root_ia_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN OAUTH2 (OPCIONAL)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu-client-id-google
GOOGLE_CLIENT_SECRET=tu-client-secret-google

GITHUB_CLIENT_ID=tu-client-id-github
GITHUB_CLIENT_SECRET=tu-client-secret-github

LINKEDIN_CLIENT_ID=tu-client-id-linkedin
LINKEDIN_CLIENT_SECRET=tu-client-secret-linkedin
