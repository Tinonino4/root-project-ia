# Configuración de Observabilidad para Grafana Cloud (OTel)

# 1. Endpoint OTLP provisto por Grafana Cloud (HTTPS con path /otlp)
# Ejemplo: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp

# 2. ID de Instancia provisto en el panel de OTel en Grafana Cloud (ej: 123456)
GRAFANA_CLOUD_INSTANCE_ID=tu_instance_id_aqui

# 3. API Key / Token de Grafana Cloud con rol de escritura de métricas, logs y trazas
GRAFANA_CLOUD_API_KEY=glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
